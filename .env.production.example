APP_NAME=SBS AI ITSM
APP_ENV=production
APP_ENV_FILE=.env.production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=https://itsm.example.com
# Exact public hosts plus the internal Prometheus target; wildcards are rejected.
TRUSTED_HOSTS=itsm.example.com,backend
# Exact static frontend container address. Must match FRONTEND_EDGE_IP.
FORWARDED_ALLOW_IPS=172.30.250.10
SECRETS_DIR=./secrets.example
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_IP_RATE_LIMIT_ATTEMPTS=25
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
API_MAX_REQUEST_BODY_BYTES=6291456
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Service-specific budgets keep peak API concurrency inside PostgreSQL's
# connection budget while preventing the background worker from reserving it.
BACKEND_REPLICAS=3
BACKEND_DATABASE_POOL_SIZE=15
BACKEND_DATABASE_MAX_OVERFLOW=5
BACKEND_DATABASE_POOL_TIMEOUT_SECONDS=3
WORKER_DATABASE_POOL_SIZE=5
WORKER_DATABASE_MAX_OVERFLOW=2
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=5
SCHEDULER_DATABASE_POOL_SIZE=3
SCHEDULER_DATABASE_MAX_OVERFLOW=1
SCHEDULER_DATABASE_POOL_TIMEOUT_SECONDS=5
SCHEDULER_POLL_INTERVAL_SECONDS=5
SCHEDULER_LEASE_SECONDS=120
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=30
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=768M
REDIS_MAXMEMORY=512mb
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=2G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
SCHEDULER_CPU_LIMIT=1.0
SCHEDULER_MEMORY_LIMIT=1G
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=256M
PROMETHEUS_CPU_LIMIT=1.0
PROMETHEUS_MEMORY_LIMIT=2G
ALERTMANAGER_CPU_LIMIT=0.5
ALERTMANAGER_MEMORY_LIMIT=512M
GRAFANA_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=1G
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=corporate
OIDC_BUTTON_LABEL=Войти через корпоративный SSO
OIDC_ISSUER_URL=https://login.example.com/realms/company
OIDC_CLIENT_ID=sbs-ai-itsm
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_REDIRECT_URI=https://itsm.example.com/api/v1/auth/sso/callback
OIDC_SCOPES=openid,profile,email
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ALLOWED_EMAIL_DOMAINS=example.com
OIDC_AUTO_PROVISION=false
OIDC_ALLOW_EMAIL_LINKING=false
OIDC_DEFAULT_TENANT_ID=
OIDC_DEFAULT_ROLE_CODE=requester
# First-deploy sequence: keep enforcement disabled, enroll every privileged
# account, then set this to true and redeploy.
MFA_ENFORCEMENT_ENABLED=false
MFA_ISSUER_NAME=SBS AI ITSM
MFA_REQUIRED_ROLE_CODES=saas_root,organization_admin,security_officer
MFA_CHALLENGE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_SECONDS=300
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT_SECONDS=10
CLOUDWATCH_REGION=us-east-1
CLOUDWATCH_NAMESPACE=SBS-AI-ITSM
# Optional direct job-alert channels. SMTP password, Slack webhook URL,
# PagerDuty routing key, and custom webhook URL are Docker secrets.
JOBS_ALERT_SMTP_HOST=
JOBS_ALERT_SMTP_PORT=587
JOBS_ALERT_SMTP_FROM_ADDRESS=
JOBS_ALERT_SMTP_USERNAME=
JOBS_ALERT_SMTP_STARTTLS=true
JOBS_ALERT_EMAIL_RECIPIENTS=
JOBS_ALERT_TIMEOUT_SECONDS=10
EMAIL_PUBLIC_BASE_URL=https://itsm.example.com
EMAIL_ATTACHMENT_STORAGE_PATH=/var/lib/sbs-ai-itsm/email-attachments
EMAIL_GRAPH_TIMEOUT_SECONDS=20
EMAIL_POLL_INTERVAL_SECONDS=30
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_CLAMAV_HOST=
EMAIL_CLAMAV_PORT=3310
EMAIL_ATTACHMENT_MANUAL_RELEASE_WITHOUT_CLEAN_SCAN=false
EMAIL_ATTACHMENT_DOWNLOAD_TOKEN_TTL_SECONDS=60
TEAMS_PUBLIC_BASE_URL=https://itsm.example.com
TEAMS_WEBHOOK_ALLOWED_HOSTS=.logic.azure.com,.webhook.office.com,.environment.api.powerplatform.com,.api.powerplatform.com
TEAMS_REQUEST_TIMEOUT_SECONDS=15
TEAMS_WORKER_BATCH_SIZE=50
MONITORING_WORKER_BATCH_SIZE=100
MONITORING_RECEIPT_RETENTION_DAYS=30
MONITORING_GLOBAL_MAX_PAYLOAD_BYTES=2097152
ASSET_DISCOVERY_WORKER_BATCH_SIZE=10
ASSET_DISCOVERY_REQUEST_TIMEOUT_SECONDS=30
ASSET_DISCOVERY_SCCM_ALLOWED_HOSTS=sccm-admin.example.internal
INTEGRATION_PLATFORM_WORKER_BATCH_SIZE=50
INTEGRATION_PLATFORM_MAX_ACTIVE_TOKENS_PER_ACCOUNT=10
INTEGRATION_PLATFORM_REQUEST_LOG_RETENTION_DAYS=90
INTEGRATION_PLATFORM_DELIVERY_RETENTION_DAYS=90
INTEGRATION_OUTBOUND_WEBHOOK_TIMEOUT_SECONDS=15
INTEGRATION_OUTBOUND_WEBHOOK_MAX_PAYLOAD_BYTES=262144
# Exact HTTPS destinations only; wildcard/suffix matching is intentionally unsupported.
INTEGRATION_OUTBOUND_WEBHOOK_ALLOWED_HOSTS=automation.example.com,events.example.com
WORKFLOW_WORKER_BATCH_SIZE=50
WORKFLOW_MAX_CONTEXT_BYTES=262144
WORKFLOW_EXECUTION_RETENTION_DAYS=180
CONFIGURATION_PACKAGE_SIGNING_KEY=CHANGE-ME-GENERATE-AN-INDEPENDENT-SECRET
CONFIGURATION_PACKAGE_MAX_BYTES=4194304
CONFIGURATION_PACKAGE_MAX_COMPONENTS=500
AI_RAG_EMBEDDING_DIMENSIONS=256
AI_RAG_CHUNK_CHARS=1200
AI_RAG_CHUNK_OVERLAP_CHARS=160
AI_RAG_DOCUMENT_MAX_CHARS=200000
AI_RAG_MAX_CANDIDATE_CHUNKS=1000
AI_RAG_MAX_CITATIONS=8
AI_RAG_MAX_CONTEXT_CHARS=16000
AI_RAG_QUERY_LOG_RETENTION_DAYS=180
DEMO_MODE=false
SEED_DEMO_CATALOG=false
RUN_STARTUP_DDL=false
FRONTEND_PORT=80
FRONTEND_BIND_ADDRESS=127.0.0.1
# Pick an unused private subnet before deployment. The TLS proxy connects through
# EDGE_GATEWAY; Nginx trusts forwarded client IPs only from this exact address.
EDGE_SUBNET=172.30.250.0/24
EDGE_GATEWAY=172.30.250.1
FRONTEND_EDGE_IP=172.30.250.10
TLS_PROXY_CIDR=172.30.250.1/32
# Per-IP edge limits. Login remains intentionally much stricter than the
# authenticated API so an office behind one NAT can use the platform safely.
API_RATE_LIMIT=300r/s
API_BURST=600
API_CONNECTION_LIMIT=200
LOGIN_RATE_LIMIT=5r/s
LOGIN_RATE_BURST=10
BOOTSTRAP_ROOT_EMAIL=root@example.com
DASHBOARD_REALTIME_TRANSPORT=redis
DASHBOARD_PUBSUB_CHANNEL=sbs:dashboard:events
DASHBOARD_SOCKET_TOKEN_TTL_SECONDS=60
DASHBOARD_WS_SESSION_TTL_SECONDS=3600
DASHBOARD_WS_MAX_CONNECTIONS_PER_TENANT=200
JOBS_EXECUTOR_MODE=redis
JOBS_QUEUE_NAME=jobs:queue
JOBS_DEAD_LETTER_QUEUE_NAME=jobs:dead-letter
JOBS_RETRY_BASE_SECONDS=0.5
JOBS_RETRY_MAX_SECONDS=15
POSTGRES_DB=sbs_itsm
POSTGRES_USER=sbs_itsm
GRAFANA_ADMIN_USER=admin
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
VITE_API_BASE_URL=/api/v1
