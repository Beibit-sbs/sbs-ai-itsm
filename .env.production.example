APP_NAME=SBS AI ITSM
APP_ENV=production
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=https://itsm.example.com
JWT_SECRET_KEY=replace-with-strong-random-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080
DEMO_MODE=false
RUN_STARTUP_DDL=false
DEMO_ROOT_EMAIL=root@example.com
DEMO_ROOT_PASSWORD=replace-with-strong-password
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+psycopg://sbs_itsm:replace_password@postgres:5432/sbs_itsm
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=sbs_itsm
POSTGRES_USER=sbs_itsm
POSTGRES_PASSWORD=replace_password
VITE_API_BASE_URL=https://itsm.example.com/api/v1
