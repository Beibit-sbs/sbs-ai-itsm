APP_NAME=SBS AI ITSM
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080
DEMO_MODE=true
RUN_STARTUP_DDL=true
DEMO_ROOT_EMAIL=root@sbs.local
DEMO_ROOT_PASSWORD=Root!2026
DEMO_ADMIN_EMAIL=admin@sbs.local
DEMO_ADMIN_PASSWORD=Sbs!2026
DATABASE_URL=postgresql+psycopg://sbs_itsm:change_me_before_production@postgres:5432/sbs_itsm
REDIS_URL=redis://redis:6379/0
JOBS_EXECUTOR_MODE=redis
JOBS_QUEUE_NAME=jobs:queue
JOBS_DEAD_LETTER_QUEUE_NAME=jobs:dead-letter
JOBS_RETRY_BASE_SECONDS=0.5
JOBS_RETRY_MAX_SECONDS=15
POSTGRES_DB=sbs_itsm
POSTGRES_USER=sbs_itsm
POSTGRES_PASSWORD=change_me_before_production
VITE_API_BASE_URL=http://localhost:8000/api/v1
